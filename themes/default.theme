# mydba-tui default theme
#
# Base theme configuration.
# This file defines the default visual style used by the application.

[theme]

name = "default"
description = "Default mydba-tui theme"


[colors]

# Application background and foreground
background = "#0f111a"
foreground = "#d8dee9"

# Primary interface colors
primary = "#5e81ac"
secondary = "#81a1c1"
accent = "#88c0d0"

# Status colors
success = "#a3be8c"
warning = "#ebcb8b"
error = "#bf616a"
info = "#8fbcbb"


[panels]

# Main workspace panels
panel_background = "#161b22"
panel_border = "#4c566a"
panel_title = "#88c0d0"


[navigation]

# Object browser and menus
selected_item = "#5e81ac"
highlight = "#81a1c1"
disabled = "#616e88"


[sql]

# SQL editor colors
keyword = "#81a1c1"
function = "#b48ead"
string = "#a3be8c"
number = "#ebcb8b"
comment = "#616e88"
operator = "#d08770"


[status]

# Footer and status bar
connected = "#a3be8c"
disconnected = "#bf616a"
running = "#ebcb8b"


[table]

# Result table formatting
header = "#5e81ac"
row = "#d8dee9"
alternate_row = "#2e3440"
border = "#4c566a"
